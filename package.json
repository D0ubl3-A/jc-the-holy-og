{
  "name": "jc-the-holy-og",
  "version": "0.2.0",
  "description": "JC The Holy OG: Sin City Redemption 3D desktop edition",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "electron": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "tech.illcoai.jctheholyog",
    "productName": "JC The Holy OG",
    "asar": true,
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "real-city-climb-demo.html",
      "jc-the-holy-og-assets/**/*",
      "world/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "JC-The-Holy-OG-${version}-${arch}-Setup.${ext}",
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
